# Production Environment Variables for PicUr
# Copy this file to .env.production and fill in the values

# ============================================
# Database Configuration
# ============================================
POSTGRES_USER=picur
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=picur
POSTGRES_PORT=5432

# ============================================
# MinIO Configuration
# ============================================
MINIO_ROOT_USER=CHANGE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MINIO_BUCKET=photos
MINIO_SECURE=false
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BROWSER_REDIRECT_URL=https://minio.yourdomain.com
# REQUIRED in production. Format: <name>:<base64-32-byte-key>
# Generate: KEY=$(openssl rand -base64 32) && echo "picur-master:$KEY"
# MinIO uses this to encrypt new objects (SSE-S3); app put_object calls
# pass sse=SseS3() so without this every upload 400s. The key MUST stay
# stable across restarts — losing it makes encrypted objects unreadable.
# Back it up in a password manager.
MINIO_KMS_SECRET_KEY=picur-master:CHANGE_ME_BASE64_32_BYTE_KEY

# ============================================
# Redis Configuration
# ============================================
REDIS_PORT=6379

# ============================================
# JWT Configuration
# ============================================
# Generate a strong secret key: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ============================================
# Application Configuration
# ============================================
# REQUIRED in prod — backend asserts this is "production" + secrets are real.
# If unset or wrong, dev defaults bypass startup secret validation.
ENVIRONMENT=production
LOG_LEVEL=INFO

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins.
# REQUIRED — must NOT contain "localhost" in production (startup will block).
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ============================================
# Frontend / MinIO external URLs (used for guest links + photo URLs)
# ============================================
FRONTEND_URL=https://yourdomain.com
MINIO_EXTERNAL_ENDPOINT=yourdomain.com/storage
MINIO_EXTERNAL_SECURE=true

# ============================================
# Stripe (REQUIRED in production)
# ============================================
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ============================================
# SMTP (REQUIRED in production)
# ============================================
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@yourdomain.com

# ============================================
# Domain Configuration
# ============================================
DOMAIN=yourdomain.com
NEXT_PUBLIC_API_URL=https://yourdomain.com/api

# ============================================
# Service Ports (External)
# ============================================
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ============================================
# Scaling Configuration
# ============================================
BACKEND_WORKERS=4
BACKEND_REPLICAS=1
WORKER_REPLICAS=2
FRONTEND_REPLICAS=1

# ============================================
# CompreFace Configuration
# ============================================
COMPREFACE_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Fill these AFTER creating services in CompreFace admin
COMPREFACE_API_KEY=
COMPREFACE_DETECTION_API_KEY=

# ============================================
# Cloudflare Turnstile (optional bot defence for POST /report)
# ============================================
# BOTH set → captcha enforced (modal renders the widget, backend verifies
# the token via siteverify before creating a row).
# BOTH empty → captcha disabled (useful for dev / pre-launch).
# Anything else (only site set, or only secret set) → backend REFUSES to
# start in production. The site key is baked into the frontend build via
# the Dockerfile ARG and is also passed into the backend container so the
# startup pair-check can fire; the secret key stays backend-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# ============================================
# Google OAuth — "Sign in with Google" (optional)
# ============================================
# Create a Web application OAuth client at
# https://console.cloud.google.com/apis/credentials and register:
#   Authorized JavaScript origin: https://yourdomain.com
#   Authorized redirect URI:      https://yourdomain.com/api/auth/google/callback
#
# BOTH set → Google sign-in enabled (and set NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true
#            so the frontend shows the button).
# BOTH empty → feature disabled.
# Only one set → backend REFUSES to start in production (half-configured).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set to "true" to reveal the "Continue with Google" button. Baked into the
# frontend build via the Dockerfile ARG — keep in lockstep with the two
# GOOGLE_CLIENT_* values above. Leave empty to hide the button.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=
# Optional override; defaults to {FRONTEND_URL}/api/auth/google/callback.
# Only set this if your routing differs from the standard /api prefix.
# GOOGLE_OAUTH_REDIRECT_URI=

# ============================================
# Backup Configuration (for scripts)
# ============================================
BACKUP_DIR=/backups
# Backup retention is pinned to 7 days to match the privacy/terms copy
# (deletion is honoured in active systems immediately, and rolls out of
# backups within 7 days). Don't increase without updating those pages.
BACKUP_RETENTION_DAYS=7

# ============================================
# Person Re-Identification (body matching)
# ============================================
# Pairs a body/clothing embedding with the face match to separate
# biological lookalikes (siblings, parent/child) who pass the face gate.
# The reid-api sidecar URL uses the in-cluster default
# (http://reid-api:5000) and needs no entry here.
#
# Indexing/backfill: ON by default — every newly-indexed face gets a body
# embedding, fail-soft to NULL if the sidecar is down.
REID_ENABLED_INDEXING=true
# Scan-time gate: OFF by default (Phase 2 shadow mode — the gate decision
# is logged to scan_match_metrics.reid_would_pass but NOT enforced).
# PHASE 3: flip to true ONLY after ~48h of shadow data confirms a known
# sibling pair separates (sister reid_similarity < ~0.40, self > ~0.65),
# then `docker compose restart backend`. Rollback = set back to false +
# restart. No code deploy either way.
REID_ENABLED_SCAN=false
# A candidate is only Re-ID-gated when its face similarity already cleared
# this floor (the gate guards face-confident matches the body contradicts).
REID_FACE_MIN_FOR_GATE=0.90
# Minimum body cosine to count as the same person. Below this AND above the
# face floor → the match is dropped (Phase 3) / logged as would-fail (Phase 2).
REID_SIMILARITY_THRESHOLD=0.65
