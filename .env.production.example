# Production Environment Variables for PicUr
# Copy this file to .env.production and fill in the values

# ============================================
# Database Configuration
# ============================================
POSTGRES_USER=picur
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=picur
POSTGRES_PORT=5432

# ============================================
# MinIO Configuration
# ============================================
MINIO_ROOT_USER=CHANGE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MINIO_BUCKET=photos
MINIO_SECURE=false
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BROWSER_REDIRECT_URL=https://minio.yourdomain.com

# ============================================
# Redis Configuration
# ============================================
REDIS_PORT=6379

# ============================================
# JWT Configuration
# ============================================
# Generate a strong secret key: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ============================================
# Application Configuration
# ============================================
# REQUIRED in prod — backend asserts this is "production" + secrets are real.
# If unset or wrong, dev defaults bypass startup secret validation.
ENVIRONMENT=production
LOG_LEVEL=INFO

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins.
# REQUIRED — must NOT contain "localhost" in production (startup will block).
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ============================================
# Frontend / MinIO external URLs (used for guest links + photo URLs)
# ============================================
FRONTEND_URL=https://yourdomain.com
MINIO_EXTERNAL_ENDPOINT=yourdomain.com/storage
MINIO_EXTERNAL_SECURE=true

# ============================================
# Stripe (REQUIRED in production)
# ============================================
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ============================================
# SMTP (REQUIRED in production)
# ============================================
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@yourdomain.com

# ============================================
# Domain Configuration
# ============================================
DOMAIN=yourdomain.com
NEXT_PUBLIC_API_URL=https://yourdomain.com/api

# ============================================
# Service Ports (External)
# ============================================
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ============================================
# Scaling Configuration
# ============================================
BACKEND_WORKERS=4
BACKEND_REPLICAS=1
WORKER_REPLICAS=2
FRONTEND_REPLICAS=1

# ============================================
# CompreFace Configuration
# ============================================
COMPREFACE_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Fill these AFTER creating services in CompreFace admin
COMPREFACE_API_KEY=
COMPREFACE_DETECTION_API_KEY=

# ============================================
# Backup Configuration (for scripts)
# ============================================
BACKUP_DIR=/backups
# Backup retention is pinned to 7 days to match the privacy/terms copy
# (deletion is honoured in active systems immediately, and rolls out of
# backups within 7 days). Don't increase without updating those pages.
BACKUP_RETENTION_DAYS=7
