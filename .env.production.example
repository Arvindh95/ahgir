# Production Environment Variables for PicUr
# Copy this file to .env.production and fill in the values

# ============================================
# Database Configuration
# ============================================
POSTGRES_USER=picur
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=picur
POSTGRES_PORT=5432

# ============================================
# MinIO Configuration
# ============================================
MINIO_ROOT_USER=CHANGE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MINIO_BUCKET=photos
MINIO_SECURE=false
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BROWSER_REDIRECT_URL=https://minio.yourdomain.com

# ============================================
# Redis Configuration
# ============================================
REDIS_PORT=6379

# ============================================
# JWT Configuration
# ============================================
# Generate a strong secret key: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ============================================
# Application Configuration
# ============================================
ENVIRONMENT=production
LOG_LEVEL=INFO

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ============================================
# Domain Configuration
# ============================================
DOMAIN=yourdomain.com
NEXT_PUBLIC_API_URL=https://yourdomain.com/api

# ============================================
# Service Ports (External)
# ============================================
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ============================================
# Scaling Configuration
# ============================================
BACKEND_WORKERS=4
BACKEND_REPLICAS=1
WORKER_REPLICAS=2
FRONTEND_REPLICAS=1

# ============================================
# Backup Configuration (for scripts)
# ============================================
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=30
