picur.my {
    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=(self)"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://js.stripe.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://picur.my; font-src 'self' data:; connect-src 'self' https://api.stripe.com; frame-src https://js.stripe.com https://hooks.stripe.com; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
        -Server
    }

    # Cap upload size at 25MB (matches backend MAX_UPLOAD_BYTES — Phase 5 sets enforcer)
    request_body {
        max_size 25MB
    }

    # Enable compression
    encode gzip zstd

    # Backend API - strip /api prefix and forward to FastAPI
    handle /api/* {
        uri strip_prefix /api
        reverse_proxy backend:8000
    }

    # /storage/* MinIO direct proxy was removed in Phase 2 (signed-URL hardening).
    # Photos now flow via /api/photos/{event_id}/{image_id}/{type} with HMAC signatures
    # validated by the backend. MinIO bucket should be set to private — anonymous
    # GET on the bucket must be denied.

    # Next.js static assets (hashed filenames, safe to cache forever)
    handle /_next/static/* {
        header Cache-Control "public, max-age=31536000, immutable"
        reverse_proxy frontend:3000
    }

    # Health check endpoint
    handle /health {
        reverse_proxy backend:8000
    }

    # Frontend - serve Next.js app
    handle /* {
        reverse_proxy frontend:3000
    }
}
