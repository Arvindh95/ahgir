picur.my {
    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    encode gzip zstd

    # Cap upload size at 25MB (matches backend MAX_UPLOAD_BYTES)
    request_body {
        max_size 25MB
    }

    # /storage/* MinIO direct proxy was removed for the signed-URL hardening.
    # Photos flow via /api/photos/{event_id}/{image_id}/{type} with HMAC
    # signatures validated by the backend. MinIO bucket must remain private.

    # Backend API - strip /api prefix and forward to FastAPI
    handle /api/* {
        uri strip_prefix /api
        reverse_proxy backend:8000
    }

    # Health check
    handle /health {
        reverse_proxy backend:8000
    }

    # Frontend - catch-all (must be last)
    handle {
        reverse_proxy frontend:3000
    }

    log {
        output file /var/log/caddy/access.log
        format json
    }
}
